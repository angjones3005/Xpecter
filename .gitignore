# Go
/build/*
!/build/appicon.png

# Frontend
frontend/node_modules/
frontend/dist/
# Copied out of pdfjs-dist by frontend/scripts/copy-pdfjs-assets.mjs on
# every build, so the PDF viewer has the standard PDF fonts as files.
# Vendored third-party binaries, regenerated on demand: not ours to keep.
frontend/public/pdfjs/
# Regenerated by every wails build and imported by nothing: main.ts takes
# its types from the hand-written frontend/wailsjs.d.ts and its runtime
# from window.runtime. Tracking it just dirtied the tree on each build.
frontend/wailsjs/

# OS
.DS_Store
/xpecter
/xpecter.exe
